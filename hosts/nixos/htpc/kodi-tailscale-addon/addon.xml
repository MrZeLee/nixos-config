<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tailscale-toggle" name="Tailscale" version="1.0.0" provider-name="htpc">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Toggle Tailscale on/off</summary>
    <description lang="en_GB">Connects or disconnects the box from the tailnet.</description>
    <platform>all</platform>
  </extension>
</addon>