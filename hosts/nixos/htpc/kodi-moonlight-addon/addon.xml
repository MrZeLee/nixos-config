<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.moonlight-launcher" name="Moonlight" version="1.0.0" provider-name="htpc">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Launch Moonlight game streaming</summary>
    <description lang="en_GB">Quits Kodi and starts moonlight-qt; Kodi restarts when Moonlight exits.</description>
    <platform>all</platform>
  </extension>
</addon>
